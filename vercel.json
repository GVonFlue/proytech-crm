{
  "crons": [
    {
      "path": "/api/content-slate",
      "schedule": "0 1 * * 1"
    },
    {
      "path": "/api/client-emails-cron",
      "schedule": "0 15 * * *"
    },
    {
      "path": "/api/client-emails-cron",
      "schedule": "0 16 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/p/:slug",
      "destination": "/proposal.html"
    },
    {
      "source": "/onboarding/:slug",
      "destination": "/onboarding.html"
    },
    {
      "source": "/portal",
      "destination": "/portal.html"
    }
  ],
  "redirects": [
    {
      "source": "/((?!p/[^/]+$|proposal\\.html$|onboarding/[^/]+$|onboarding\\.html$|assets/|team/[^/]+\\.(?:png|jpe?g|webp)$|api/proposal-public$|api/onboarding-public$|[^/]+\\.(?:png|jpe?g|svg|webp|ico|gif)$).*)",
      "has": [
        {
          "type": "host",
          "value": "proposals.getproytech.com"
        }
      ],
      "destination": "https://getproytech.com",
      "permanent": false
    }
  ]
}
